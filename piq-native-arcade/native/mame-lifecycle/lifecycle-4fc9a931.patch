diff --git a/src/frontend/mame/ui/systemlist.cpp b/src/frontend/mame/ui/systemlist.cpp
--- a/src/frontend/mame/ui/systemlist.cpp
+++ b/src/frontend/mame/ui/systemlist.cpp
@@ -51,7 +51,15 @@
 {
 	std::unique_lock<std::mutex> lock(m_mutex);
 	if (m_thread)
-		m_thread->join();
+	{
+		// The owner serializes cache/reset calls. Keep m_started set until the
+		// worker finishes, but release the mutex needed by notify_available.
+		// Joining with this lock held can deadlock during an early shutdown.
+		lock.unlock();
+		if (m_thread->joinable())
+			m_thread->join();
+		lock.lock();
+	}
 	m_thread.reset();
 	m_started = false;
 	m_available = AVAIL_NONE;
