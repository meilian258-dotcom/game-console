 	delete retro_global_config;
+	retro_global_config = nullptr;
 }
 
 void retro_finish()
 {
-	retro_global_machine->retro_machine_exit();
+	// Failed startup already emits exit notifications in running_machine::run.
+	// Only a successfully yielded machine still needs its normal exit sequence.
+	if (retro_global_machine && retro_global_machine->phase() == machine_phase::RUNNING)
+		retro_global_machine->retro_machine_exit();
 
 	free_machineconfig();
 	free_man();
+	// The UI is gone; join its static cache worker before DLL detach takes
+	// the loader lock. Its thread must be able to finish LdrShutdownThread.
+	// Core lifecycle calls, including this reset, stay serialized by the owner.
+	ui::system_list::instance().reset_cache();
+	// OSD owns registered modules, including dormant network/Asio services.
+	// Destroy it before the frontend is allowed to unload this shared library.
+	retro_finish_osd();
 }
 
