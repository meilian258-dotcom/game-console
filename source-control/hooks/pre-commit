#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
configured_python="$(git config --local --get piq.python || true)"
if [ -n "$configured_python" ]; then
  exec "$configured_python" source-control/audit.py --staged
fi
if command -v python3 >/dev/null 2>&1; then
  exec python3 source-control/audit.py --staged
fi
if command -v python >/dev/null 2>&1; then
  exec python source-control/audit.py --staged
fi
echo "Python 3.11+ required. Set repository-local piq.python; see GIT_WORKFLOW.md." >&2
exit 1
